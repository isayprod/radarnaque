        "description": "Appel\u00e9 par le service auth \u00e0 la cr\u00e9ation d'un utilisateur. Idempotent.",
        "operationId": "bootstrap_user_api_internal_users__user_id__bootstrap_post",
        "parameters": [
          {
            "in": "path",
            "name": "user_id",
            "required": true,
            "schema": {
              "title": "User Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-internal-secret",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
