		"@types/node": "^24.0.0",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.1.2",
		"@wxt-dev/module-react": "^1.2.2",
		"happy-dom": "^21.0.0",
		"tailwindcss": "~4.3.3",
		"typescript": "~6.0.3",
		"vite": "^8.0.0",
		"vitest": "^5.0.5",
