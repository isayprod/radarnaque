# Copier vers apps/extension/.env (jamais versionné).

# Origine du site, de /auth et de /api.
# Dev : http://localhost:8080 (Caddy). Prod : https://radarnaque.mostconsult.be
WXT_PUBLIC_URL=http://localhost:8080

# Clé publique de l'extension (DER en base64) : fixe l'identifiant de l'extension en dev
# comme en prod. Générer une paire de clés, puis lire la valeur et l'identifiant :
#   openssl genrsa -out infra/extension-dev.pem 2048
#   node apps/extension/scripts/extension-id.mjs infra/extension-dev.pem
# L'identifiant affiché va dans EXTENSION_ID (service auth) et VITE_EXTENSION_ID (site).
WXT_EXTENSION_KEY=
