# Caddy de développement : une seule origine http://localhost:8080.
# auth (port 3000) et api (port 8000) tournent sur l'hôte ; le site est servi depuis
# apps/site/dist et l'admin (sous /admin/) depuis apps/admin/dist. On monte les dossiers
# parents (apps/site → /srv/site-src, apps/admin → /srv/admin-src, en lecture seule) et non
# les dist : un build qui supprime puis recrée dist laisserait sinon le conteneur sur
# l'ancien dossier (404 partout jusqu'à sa recréation). Seul dist est servi (root).
# Mêmes routes que le Caddyfile de production, qui copie les dist dans /srv/site et /srv/admin.
{
	admin off
	auto_https off
}

:8080 {
	# Page de retour du lien magique : chemins EXACTS, déclarés avant /auth/*.
	# Jamais de joker : Better Auth possède /auth/callback/:provider.
	@callback path /auth/callback /auth/callback/
	handle @callback {
		root * /srv/site-src/dist
		rewrite * /auth/callback/index.html
		file_server
	}

	handle /auth/* {
		reverse_proxy host.docker.internal:3000
	}

	# Routes internes (/api/internal/*, ex. bootstrap appelé par auth via http://api:8000) :
	# jamais exposées par Caddy, même protégées par X-Internal-Secret (spec §5.1).
	@internal path /api/internal /api/internal/*
	handle @internal {
		respond 404
	}

	# Analyse et identification en flux (SSE, POST /api/scans/stream et /api/identify/stream) :
	# chaque événement part aussitôt, sans tampon (flush_interval -1). Déclarées à part de
	# /api/* : un seul chemin chacune, plus précis, donc servies d'abord (tri des `handle`).
	handle /api/scans/stream {
		request_body {
			max_size 1MB
		}
		reverse_proxy host.docker.internal:8000 {
			flush_interval -1
		}
	}

	handle /api/identify/stream {
		request_body {
			max_size 1MB
		}
		reverse_proxy host.docker.internal:8000 {
			flush_interval -1
		}
	}

	handle /api/* {
		# Corps plafonné à 1 Mo (règle R14) : un scan pèse quelques Ko. L'API plafonne aussi
		# le webhook Stripe (1 Mio), sans dépendre de ce proxy.
		request_body {
			max_size 1MB
		}
		reverse_proxy host.docker.internal:8000
	}

	# Application d'administration (SPA) : /admin/* → /srv/admin, repli sur index.html.
	redir /admin /admin/ 308

	# Assets compilés (noms avec empreinte) : jamais de repli sur index.html, un fichier
	# absent donne un vrai 404. Déclaré avant /admin/*.
	handle /admin/assets/* {
		header {
			Content-Security-Policy "default-src 'self'; frame-ancestors 'none'"
			X-Frame-Options DENY
			Referrer-Policy no-referrer
			Cache-Control "public, max-age=31536000, immutable"
		}
		uri strip_prefix /admin
		root * /srv/admin-src/dist
		file_server
	}

	handle /admin/* {
		header {
			Content-Security-Policy "default-src 'self'; frame-ancestors 'none'"
			X-Frame-Options DENY
			Referrer-Policy no-referrer
			Cache-Control no-store
		}
		uri strip_prefix /admin
		root * /srv/admin-src/dist
		try_files {path} /index.html
		file_server
	}

	handle {
		root * /srv/site-src/dist
		file_server
	}
}
