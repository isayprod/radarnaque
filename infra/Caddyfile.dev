# Caddy de développement : une seule origine http://localhost:8080.
# auth (port 3000) et api (port 8000) tournent sur l'hôte ; le site est servi depuis
# apps/site/dist (monté en lecture seule dans /srv/site) ; l'admin sous /admin/ vient de
# apps/admin/dist (monté dans /srv/admin).
{
	admin off
	auto_https off
}

:8080 {
	# Page de retour du lien magique : chemins EXACTS, déclarés avant /auth/*.
	# Jamais de joker : Better Auth possède /auth/callback/:provider.
	@callback path /auth/callback /auth/callback/
	handle @callback {
		root * /srv/site
		rewrite * /auth/callback/index.html
		file_server
	}

	handle /auth/* {
		reverse_proxy host.docker.internal:3000
	}

	# Routes internes (/api/internal/*, ex. bootstrap appelé par auth via http://api:8000) :
	# jamais exposées par Caddy, même protégées par X-Internal-Secret (spec §5.1).
	@internal path /api/internal /api/internal/*
	handle @internal {
		respond 404
	}

	# Analyse en flux (SSE, POST /api/scans/stream) : chaque événement part aussitôt, sans
	# tampon (flush_interval -1). Déclaré à part de /api/* (chemin plus précis, servi d'abord).
	handle /api/scans/stream {
		request_body {
			max_size 1MB
		}
		reverse_proxy host.docker.internal:8000 {
			flush_interval -1
		}
	}

	handle /api/* {
		# Corps plafonné à 1 Mo (règle R14) : un scan pèse quelques Ko. L'API plafonne aussi
		# le webhook Stripe (1 Mio), sans dépendre de ce proxy.
		request_body {
			max_size 1MB
		}
		reverse_proxy host.docker.internal:8000
	}

	# Application d'administration (SPA) : /admin/* → /srv/admin, repli sur index.html.
	redir /admin /admin/ 308
	handle /admin/* {
		header {
			Content-Security-Policy "default-src 'self'; frame-ancestors 'none'"
			X-Frame-Options DENY
			Referrer-Policy no-referrer
		}
		# Deux matchers exclusifs : Caddy trie les directives `header` par matcher, un
		# `Cache-Control` sans matcher écraserait celui des assets.
		@adminAssets path /admin/assets/*
		@adminPages not path /admin/assets/*
		header @adminAssets Cache-Control "public, max-age=31536000, immutable"
		header @adminPages Cache-Control no-store
		root * /srv
		try_files {path} /admin/index.html
		file_server
	}

	handle {
		root * /srv/site
		file_server
	}
}
