# Copier ce fichier en infra/.env (jamais versionné) puis adapter les valeurs.

# Environnement d'exécution : development | production | test.
NODE_ENV=development

# Environnement de l'API FastAPI (elle lit ENV, pas NODE_ENV) : development | production | test.
ENV=development

# Port de Postgres sur l'hôte (127.0.0.1), lu par docker compose ; à changer si un autre
# Postgres occupe déjà 5432, en reportant la valeur dans DATABASE_URL.
POSTGRES_PORT=5432

# Chaîne de connexion Postgres unique, partagée par auth et api (format postgres://user:pass@host:5432/db ; l'API la normalise).
DATABASE_URL=postgres://radarnaque:radarnaque@localhost:5432/radarnaque

# Secret de signature des sessions Better Auth (au moins 32 caractères aléatoires : `openssl rand -hex 32`).
# Toute valeur commençant par `change-me` est refusée quand NODE_ENV=production.
BETTER_AUTH_SECRET=change-me-with-at-least-32-random-characters

# URL publique de base de Better Auth : ignorée, PUBLIC_URL fait foi (le service auth passe baseURL = PUBLIC_URL).
BETTER_AUTH_URL=http://localhost:8080

# URL publique du site (origine unique) ; sert aussi d'issuer et d'audience JWT par défaut (prod : https://radarnaque.mostconsult.be).
PUBLIC_URL=http://localhost:8080

# URL interne de l'API FastAPI, utilisée par le service auth (prod : http://api:8000).
API_INTERNAL_URL=http://localhost:8000

# URL du JWKS exposé par le service auth, pour la vérification des JWT par l'API (prod : http://auth:3000/auth/jwks).
JWKS_URL=http://localhost:3000/auth/jwks

# Issuer des JWT émis par Better Auth ; doit être égal à PUBLIC_URL.
JWT_ISSUER=http://localhost:8080

# Audience des JWT, vérifiée par l'API ; doit être égale à PUBLIC_URL.
JWT_AUDIENCE=http://localhost:8080

# Clé API Resend pour l'envoi des emails (lien magique et code OTP).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Adresse expéditrice des emails, sur un domaine vérifié chez Resend (entre guillemets : espaces et chevrons).
MAIL_FROM="Radarnaque <no-reply@radarnaque.mostconsult.be>"

# Clé API OpenRouter utilisée par l'API pour les analyses IA.
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxx

# Secret partagé entre auth et api pour les appels internes (en-tête X-Internal-Secret) ; au moins 32 caractères aléatoires (`openssl rand -hex 32`).
# Toute valeur commençant par `change-me` est refusée en production (NODE_ENV / ENV=production).
INTERNAL_API_SECRET=change-me-internal-secret-with-32-plus-characters

# Service auth : 1 = applique les migrations Better Auth (schéma `auth`) au démarrage ; sinon `pnpm --filter auth migrate`.
AUTH_MIGRATE_ON_START=1

# Identifiant de l'extension navigateur autorisée (origine chrome-extension://<id> dans les CORS et les liens magiques).
# `pnpm dev:keys` crée infra/extension-dev.pem et affiche l'identifiant qui en découle.
EXTENSION_ID=abcdefghijklmnopabcdefghijklmnop

# Site (apps/site) : identifiant de l'extension compilé dans la page de retour /auth/callback,
# lu au build par `pnpm dev:site`. Même valeur qu'EXTENSION_ID.
VITE_EXTENSION_ID=abcdefghijklmnopabcdefghijklmnop

# --- Production (infra/docker-compose.yml) -----------------------------------------------
# En production, copier ce fichier en infra/.env sur le serveur et adapter. La composition
# fixe elle-même NODE_ENV=production, ENV=production, DATABASE_URL (postgres:5432),
# API_INTERNAL_URL (http://api:8000) et JWKS_URL (http://auth:3000/auth/jwks) : les valeurs
# de développement ci-dessus pour ces variables sont ignorées. JWT_ISSUER et JWT_AUDIENCE
# prennent la valeur de PUBLIC_URL (https://radarnaque.mostconsult.be en production).

# Mot de passe de l'utilisateur Postgres `radarnaque` (conteneur postgres de la production ; le dev utilise
# `radarnaque`, fixé dans docker-compose.dev.yml). À remplacer : auth et api refusent de démarrer en production
# si le mot de passe de DATABASE_URL commence par `change-me`.
# Placé tel quel dans DATABASE_URL : utiliser des caractères sûrs pour une URL (`openssl rand -hex 24`).
POSTGRES_PASSWORD=change-me-postgres-password

# Adresse servie par Caddy. radarnaque.mostconsult.be : HTTPS automatique (Let's Encrypt, ports 80 et 443 ouverts) ;
# http://localhost pour un essai local sans TLS.
SITE_ADDRESS=radarnaque.mostconsult.be

# Ports publiés par Caddy sur l'hôte (les seuls de la composition). À changer uniquement pour un essai local ;
# PUBLIC_URL doit alors inclure le port.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Sauvegardes (service `backup`, toutes les 24 h) : pg_dump | gzip | age, copie via rclone, 14 jours conservés en local.
# Clé PUBLIQUE age du destinataire (`age-keygen -o backup.key` ; garder backup.key hors du serveur).
BACKUP_AGE_RECIPIENT=age1qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq
# Destination rclone `<remote>:<chemin>` ; le remote est défini dans le fichier rclone.conf ci-dessous.
# Pas de purge côté distant : y configurer la rétention du fournisseur.
BACKUP_RCLONE_REMOTE=offsite:radarnaque-backups
# Dossier contenant rclone.conf, monté en lecture seule dans le conteneur backup (jamais versionné).
RCLONE_CONFIG_DIR=./backup/rclone
