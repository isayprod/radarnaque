# Caddy de production : une seule origine. SITE_ADDRESS vaut radarnaque.mostconsult.be
# (HTTPS automatique) ; http://localhost pour un essai local sans TLS.
# auth et api sont joints sur le réseau interne de docker compose ; le site compilé
# est dans l'image (/srv/site). Les routes sont celles de Caddyfile.dev.
#
# Pas de trusted_proxies : Caddy remplace X-Forwarded-For par l'IP réelle du client, donc
# le limiteur par IP du service auth ne peut pas être usurpé par un en-tête fourni.
{
	admin off
}

{$SITE_ADDRESS:radarnaque.mostconsult.be} {
	# Compression, sauf pour le flux de l'analyse : un encodeur garderait les événements en
	# tampon.
	@compressible not path /api/scans/stream
	encode @compressible zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}

	# HSTS uniquement sur une connexion TLS : absent en http://localhost (essai local).
	@secure protocol https
	header @secure Strict-Transport-Security "max-age=31536000"

	# Page de retour du lien magique : chemins EXACTS, déclarés avant /auth/*.
	# Jamais de joker : Better Auth possède /auth/callback/:provider.
	@callback path /auth/callback /auth/callback/
	handle @callback {
		root * /srv/site
		rewrite * /auth/callback/index.html
		file_server
	}

	handle /auth/* {
		reverse_proxy auth:3000
	}

	# Routes internes (/api/internal/*, ex. bootstrap appelé par auth via http://api:8000) :
	# jamais exposées par Caddy, même protégées par X-Internal-Secret (spec §5.1).
	@internal path /api/internal /api/internal/*
	handle @internal {
		respond 404
	}

	# Analyse en flux (SSE, POST /api/scans/stream) : chaque événement part aussitôt, sans
	# tampon (flush_interval -1). Déclaré à part de /api/* (chemin plus précis, servi d'abord).
	handle /api/scans/stream {
		request_body {
			max_size 1MB
		}
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	handle /api/* {
		# Corps plafonné à 1 Mo (règle R14) : un scan pèse quelques Ko. L'API plafonne aussi
		# le webhook Stripe (1 Mio), sans dépendre de ce proxy.
		request_body {
			max_size 1MB
		}
		reverse_proxy api:8000
	}

	handle {
		root * /srv/site
		file_server
	}
}
