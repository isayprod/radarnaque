# Caddy de production : une seule origine. SITE_ADDRESS vaut radarnaque.mostconsult.be
# (HTTPS automatique) ; http://localhost pour un essai local sans TLS.
# auth et api sont joints sur le réseau interne de docker compose ; le site compilé
# est dans l'image (/srv/site), l'admin aussi (/srv/admin, servi sous /admin/). Les routes sont
# celles de Caddyfile.dev.
#
# Pas de trusted_proxies : Caddy remplace X-Forwarded-For par l'IP réelle du client, donc
# le limiteur par IP du service auth ne peut pas être usurpé par un en-tête fourni.
{
	admin off
}

{$SITE_ADDRESS:radarnaque.mostconsult.be} {
	# Compression, sauf pour les flux de l'analyse et de l'identification : un encodeur
	# garderait les événements en tampon.
	@compressible not path /api/scans/stream /api/identify/stream
	encode @compressible zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}

	# HSTS uniquement sur une connexion TLS : absent en http://localhost (essai local).
	@secure protocol https
	header @secure Strict-Transport-Security "max-age=31536000"

	# Page de retour du lien magique : chemins EXACTS, déclarés avant /auth/*.
	# Jamais de joker : Better Auth possède /auth/callback/:provider.
	@callback path /auth/callback /auth/callback/
	handle @callback {
		root * /srv/site
		rewrite * /auth/callback/index.html
		file_server
	}

	handle /auth/* {
		reverse_proxy auth:3000
	}

	# Routes internes (/api/internal/*, ex. bootstrap appelé par auth via http://api:8000) :
	# jamais exposées par Caddy, même protégées par X-Internal-Secret (spec §5.1).
	@internal path /api/internal /api/internal/*
	handle @internal {
		respond 404
	}

	# Analyse et identification en flux (SSE, POST /api/scans/stream et /api/identify/stream) :
	# chaque événement part aussitôt, sans tampon (flush_interval -1). Déclarées à part de
	# /api/* : un seul chemin chacune, plus précis, donc servies d'abord (tri des `handle`).
	handle /api/scans/stream {
		request_body {
			max_size 1MB
		}
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	handle /api/identify/stream {
		request_body {
			max_size 1MB
		}
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	handle /api/* {
		# Corps plafonné à 1 Mo (règle R14) : un scan pèse quelques Ko. L'API plafonne aussi
		# le webhook Stripe (1 Mio), sans dépendre de ce proxy.
		request_body {
			max_size 1MB
		}
		reverse_proxy api:8000
	}

	# Application d'administration (SPA) : /admin/* → /srv/admin, repli sur index.html.
	redir /admin /admin/ 308

	# Assets compilés (noms avec empreinte) : jamais de repli sur index.html, un fichier
	# absent donne un vrai 404. Déclaré avant /admin/*.
	handle /admin/assets/* {
		header {
			Content-Security-Policy "default-src 'self'; frame-ancestors 'none'"
			X-Frame-Options DENY
			Referrer-Policy no-referrer
			Cache-Control "public, max-age=31536000, immutable"
		}
		root * /srv
		file_server
	}

	handle /admin/* {
		header {
			Content-Security-Policy "default-src 'self'; frame-ancestors 'none'"
			X-Frame-Options DENY
			Referrer-Policy no-referrer
			Cache-Control no-store
		}
		root * /srv
		try_files {path} /admin/index.html
		file_server
	}

	handle {
		root * /srv/site
		file_server
	}
}
